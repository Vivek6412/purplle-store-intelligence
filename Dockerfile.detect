FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.detect.txt .
RUN pip install --default-timeout=1000 --no-cache-dir -r requirements.detect.txt

COPY detect.py tracker.py emit.py run.sh stream_all.py yolov8s.onnx ./

# No CMD — run manually
